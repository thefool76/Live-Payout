---
import "../styles/global.css";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  pageType?: string;
  breadcrumbs?: { name: string; path?: string }[];
  ogType?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
}

const {
  title,
  description,
  canonicalPath = "/",
  image = "/og.png",
  imageAlt = "Live Payout Whatnot fee calculator",
  imageWidth = 1731,
  imageHeight = 909,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  schema,
  pageType = "WebPage",
  breadcrumbs = [],
  ogType,
  publishedDate,
  modifiedDate,
}: Props = Astro.props;
const site = Astro.site ?? new URL("https://www.livepayoutcalculator.com");
const canonical = new URL(canonicalPath, site).href;
const imageUrl = image ? new URL(image, site).href : undefined;
const suppliedSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const suppliedArticle = suppliedSchemas.find((item) => item["@type"] === "Article");
const resolvedOgType = ogType ?? (suppliedArticle ? "article" : "website");
const resolvedPublishedDate = publishedDate ?? (typeof suppliedArticle?.datePublished === "string" ? suppliedArticle.datePublished : undefined);
const resolvedModifiedDate = modifiedDate ?? (typeof suppliedArticle?.dateModified === "string" ? suppliedArticle.dateModified : undefined);
const isIndexable = !robots.toLowerCase().includes("noindex");
const pageSchema = isIndexable ? {
  "@context": "https://schema.org",
  "@type": pageType,
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": "https://www.livepayoutcalculator.com/#website" },
  primaryImageOfPage: imageUrl ? { "@type": "ImageObject", url: imageUrl, width: imageWidth, height: imageHeight } : undefined,
} : undefined;
const breadcrumbSchema = isIndexable && breadcrumbs.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.path ? new URL(item.path, site).href : undefined,
  })),
} : undefined;
const schemas = [pageSchema, breadcrumbSchema, ...suppliedSchemas].filter(Boolean);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="application-name" content="Live Payout" />
    <meta name="author" content="Live Payout" />
    <meta name="theme-color" content="#f2d84b" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/live-payout-icon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/live-payout-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Live Payout" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content="image/png" />}
    {imageUrl && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageUrl && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {resolvedOgType === "article" && resolvedPublishedDate && <meta property="article:published_time" content={resolvedPublishedDate} />}
    {resolvedOgType === "article" && resolvedModifiedDate && <meta property="article:modified_time" content={resolvedModifiedDate} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{title}</title>
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body><slot /><Toaster client:load position="bottom-right" closeButton /></body>
</html>
